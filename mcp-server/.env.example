# HiveSchool MCP Server — Environment Variables

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# The full URL to your HiveSchool webhook endpoint.
# For local testing: http://localhost:3000/api/blogs/webhook
# For production:    https://www.hiveschool.co/api/blogs/webhook
HIVESCHOOL_WEBHOOK_URL=http://localhost:3000/api/blogs/webhook

# The secret key that authorizes the webhook call.
# This MUST match CLAUDE_WEBHOOK_SECRET in your main .env.local file.
HIVESCHOOL_WEBHOOK_SECRET=hive-claude-secure-secret-2026!

# The public URL of your site (used in success messages so Claude can show you the live URL).
# For local testing: http://localhost:3000
# For production:    https://www.hiveschool.co
HIVESCHOOL_SITE_URL=http://localhost:3000

# ── OPTIONAL (but recommended) ────────────────────────────────────────────────

# Unsplash API Access Key for high-quality, topic-relevant cover photos.
# Get a FREE key in 2 minutes: https://unsplash.com/developers
# If left blank, the server will use Picsum Photos as a fallback (still looks great).
UNSPLASH_ACCESS_KEY=
